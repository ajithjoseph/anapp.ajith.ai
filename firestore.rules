rules_version = '2';
// Launch a Day. Everything public is readable by anyone; every write is
// checked here, because there is no server. Paste into Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isLink(v) { return v is string && v.size() <= 300 && v.matches('^https?://[^\\s]+$'); }
    function isDay(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // A maker's "today" is their own date. Anywhere on Earth that is the UTC
    // date, the day before or the day after, so only those can be written:
    // no backfilling old days to fake a streak.
    function isCurrentDay(d) {
      let t = timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
      return isDay(d)
        && t > request.time - duration.value(38, 'h')
        && t < request.time + duration.value(15, 'h');
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    match /users/{uid} {
      function validUser(u) {
        return u.keys().hasOnly(['handle', 'name', 'bio', 'tz', 'createdAt'])
          && isText(u.name, 1, 60) && isText(u.bio, 0, 160) && isText(u.tz, 1, 64);
      }
      allow read: if true;
      // Created in the same batch that claims the username.
      allow create: if signedIn() && uid == me()
        && validUser(request.resource.data)
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == me();
      allow update: if signedIn() && uid == me()
        && validUser(request.resource.data)
        && request.resource.data.handle == resource.data.handle;
      allow delete: if false;
    }

    match /plans/{id} {
      // By id, not resource.data, so asking for today's plan before it exists is allowed.
      allow read, delete: if signedIn() && id.split('_')[0] == me();
      allow create, update: if signedIn()
        && request.resource.data.uid == me()
        && id == me() + '_' + request.resource.data.day
        && isDay(request.resource.data.day)
        && request.resource.data.keys().hasOnly(['uid', 'day', 'idea', 'scope', 'steps'])
        && isText(request.resource.data.idea, 0, 200)
        && isText(request.resource.data.scope, 0, 280)
        && request.resource.data.steps is map;
    }

    match /launches/{id} {
      function validLaunch(l) {
        return isText(l.title, 1, 60) && isText(l.tagline, 1, 120) && isLink(l.url)
          && (l.repoUrl == '' || isLink(l.repoUrl))
          && isText(l.notes, 0, 1000)
          && l.tags is list && l.tags.size() <= 5;
      }
      function voteDoc() { return /databases/$(database)/documents/votes/$(id + '_' + me()); }
      function profile() { return get(/databases/$(database)/documents/users/$(me())).data; }

      allow read: if true;

      allow create: if signedIn()
        && id == me() + '_' + request.resource.data.day
        && request.resource.data.uid == me()
        && request.resource.data.votes == 0
        && request.resource.data.handle == profile().handle
        && request.resource.data.keys().hasOnly(['uid', 'day', 'handle', 'name', 'title', 'tagline', 'url',
                                                  'repoUrl', 'notes', 'tags', 'votes', 'createdAt', 'updatedAt'])
        && isCurrentDay(request.resource.data.day)
        && validLaunch(request.resource.data);

      // The maker edits their launch until their day ends...
      allow update: if signedIn() && (
        (resource.data.uid == me()
          && isCurrentDay(resource.data.day)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'tagline', 'url', 'repoUrl', 'notes', 'tags', 'name', 'updatedAt'])
          && validLaunch(request.resource.data))
        // ...and anyone else can only move the vote count by one, together
        // with adding or removing their own vote in the same batch.
        || (resource.data.uid != me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && ((request.resource.data.votes == resource.data.votes + 1 && !exists(voteDoc()) && existsAfter(voteDoc()))
            || (request.resource.data.votes == resource.data.votes - 1 && exists(voteDoc()) && !existsAfter(voteDoc()))))
      );

      allow delete: if signedIn() && resource.data.uid == me() && isCurrentDay(resource.data.day);
    }

    match /votes/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'launchId'])
        && request.resource.data.uid == me()
        && id == request.resource.data.launchId + '_' + me()
        && get(/databases/$(database)/documents/launches/$(request.resource.data.launchId)).data.uid != me();
      allow delete: if signedIn() && resource.data.uid == me();
      allow update: if false;
    }
  }
}
